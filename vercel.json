{
  "rewrites": [
    { "source": "/search", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/category/:slug", "destination": "/index.html" },
    { "source": "/product/:slug", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/not-found", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/category/:slug", "destination": "/index.html" },
    { "source": "/shop/product/:slug", "destination": "/index.html" },
    { "source": "/shop/cart", "destination": "/index.html" },
    { "source": "/shop/checkout", "destination": "/index.html" },
    { "source": "/shop/wishlist", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/orders", "destination": "/index.html" },
    { "source": "/account/downloads", "destination": "/index.html" },
    { "source": "/collections", "destination": "/index.html" },
    { "source": "/collections/:slug", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
