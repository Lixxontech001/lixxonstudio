# ---- Frontend (Vite; exposed to the browser — only PUBLIC values here) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx-X
# optional
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=
# VITE_COMMIT_SHA=   # optional release tag for Sentry (Vercel: use $VERCEL_GIT_COMMIT_SHA)
VITE_SITE_URL=https://lixxonstudio.com

# ---- Supabase Edge Function secrets (set with: supabase secrets set KEY=value) ----
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.
# FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx          # Flutterwave secret (server-side verification)
# FLW_WEBHOOK_HASH=choose-a-long-random-string  # same value you paste in Flutterwave dashboard → Webhooks → Secret hash
# INTERNAL_FN_SECRET=choose-another-long-random-string   # protects send-emails / refresh-rates / internal fulfilment
# RATE_LIMIT_SALT=any-random-string
# RESEND_API_KEY=re_xxxxxxxx                    # optional; without it, emails are skipped gracefully
# EMAIL_FROM="Lixxon Studio <onboarding@resend.dev>"   # change once your domain is verified in Resend
# ADMIN_NOTIFY_EMAIL=you@example.com            # optional; contact-form notifications
# SITE_URL=https://lixxonstudio.com
# CHECKOUT_CURRENCY=USD
# EMAIL_DAILY_CAP=90                            # stay under Resend free tier (100/day)

# ---- GitHub Actions secrets (for the hourly email/FX cron) ----
# SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1
# INTERNAL_FN_SECRET=same-as-above
# SITE_URL=https://lixxonstudio.vercel.app   # keep-alive ping target (optional)
